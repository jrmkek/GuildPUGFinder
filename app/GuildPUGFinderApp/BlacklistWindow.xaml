<Window x:Class="GuildPUGFinderApp.BlacklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blacklist" Height="440" Width="420" MinHeight="300" MinWidth="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Blacklisted Names" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="0">
            <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      SelectionMode="Extended" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Expires in" Binding="{Binding ExpiresIn}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Remove Selected" Style="{StaticResource DangerButton}" Padding="10,6" Margin="0,0,8,0" Click="RemoveSelected_Click"/>
            <Button Content="Close" Padding="10,6" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
