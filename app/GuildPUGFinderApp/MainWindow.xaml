<Window x:Class="GuildPUGFinderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuildPUGFinder" Height="820" Width="1040" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,10,20,10">
                <TextBlock Text="GuildPUGFinder" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="screen WoW Group Finder candidates against WarcraftLogs" Margin="12,3,0,0"
                           Style="{StaticResource HelperText}" VerticalAlignment="Bottom" FontSize="11.5"/>
            </StackPanel>
        </Border>

        <!-- Primary actions - always visible, no scrolling required -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="RunButton" Content="▶  Run" Style="{StaticResource PrimaryButton}"
                        Padding="20,9" FontSize="13.5" Click="RunButton_Click"/>

                <Button Grid.Column="1" x:Name="WatchButton" Content="Start Watching" Margin="10,0,0,0" Click="WatchButton_Click"/>

                <CheckBox Grid.Column="2" x:Name="ForceFreshCheck" Content="Force fresh (ignore cache)"
                          Margin="16,0,0,0" VerticalAlignment="Center"/>

                <Button Grid.Column="3" x:Name="ViewBlacklistButton" Content="View Blacklist..." Style="{StaticResource LinkButton}"
                        Margin="16,0,0,0" VerticalAlignment="Center" Click="ViewBlacklistButton_Click"/>

                <TextBlock Grid.Column="4" x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main content: results (dominant, primary capability) + filters (secondary, narrower) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Results -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0">
                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              BorderThickness="0"
                              PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Overall %" Binding="{Binding OverallParsePercent}" Width="75"/>
                            <DataGridTextColumn Header="DPS %" Binding="{Binding DpsParsePercent}" Width="70"/>
                            <DataGridTextColumn Header="Heal %" Binding="{Binding HealParsePercent}" Width="70"/>
                            <DataGridTextColumn Header="Tank %" Binding="{Binding TankParsePercent}" Width="70"/>
                            <DataGridTextColumn Header="Ilvl" Binding="{Binding AverageItemLevel}" Width="60"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="80"/>
                            <DataGridTextColumn Header="Spec" Binding="{Binding Spec}" Width="100"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="250"/>
                            <DataGridTextColumn x:Name="PerBossColumn" Header="Per-boss" Binding="{Binding PerBossText}" Width="300" Visibility="Collapsed"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Filters - secondary, compact, scrollable -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="ELIGIBILITY" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Min best parse %" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MinParseBox" Text="50" Margin="0,0,0,8"/>

                                <TextBlock Text="Min average item level" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MinIlvlBox" Text="125" Margin="0,0,0,8"/>

                                <CheckBox x:Name="UsePerBossCheck" Content="Require every boss parse ≥" Margin="0,0,0,4"/>
                                <TextBox x:Name="MinPerBossBox" Text="40" Margin="0,0,0,2" IsEnabled="{Binding ElementName=UsePerBossCheck, Path=IsChecked}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="RAID" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Raid tier" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="RaidTierCombo" Margin="0,0,0,8" DisplayMemberPath="Name"/>

                                <CheckBox x:Name="ShowPerBossCheck" Content="Show per-boss parses in table" Margin="0"
                                          Checked="ShowPerBossCheck_Changed" Unchecked="ShowPerBossCheck_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="PARSE CATEGORIES" Style="{StaticResource SectionHeader}"/>
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="QueryOverallCheck" Content="Overall" IsChecked="True"/>
                                    <CheckBox x:Name="QueryDpsCheck" Content="DPS" IsChecked="True"/>
                                    <CheckBox x:Name="QueryHealCheck" Content="Healer" IsChecked="True"/>
                                    <CheckBox x:Name="QueryTankCheck" Content="Tank" IsChecked="True" Margin="0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CLASSES (NONE = ANY)" Style="{StaticResource SectionHeader}"/>
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="ClassWarrior" Content="Warrior"/>
                                    <CheckBox x:Name="ClassPaladin" Content="Paladin"/>
                                    <CheckBox x:Name="ClassHunter" Content="Hunter"/>
                                    <CheckBox x:Name="ClassRogue" Content="Rogue"/>
                                    <CheckBox x:Name="ClassPriest" Content="Priest"/>
                                    <CheckBox x:Name="ClassShaman" Content="Shaman"/>
                                    <CheckBox x:Name="ClassMage" Content="Mage"/>
                                    <CheckBox x:Name="ClassWarlock" Content="Warlock"/>
                                    <CheckBox x:Name="ClassDruid" Content="Druid" Margin="0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="10" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Raw class names seen (for checking the boxes above match):" Style="{StaticResource HelperText}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SeenClassesText" Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer: selection actions -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Blacklist Selected" Style="{StaticResource DangerButton}" Padding="12,7" Click="BlacklistSelected_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
